# --- Build artifacts (regenerated by build.bat) ---
build/
dist/
installer-output/
*.spec

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/

# --- User-specific local config (never commit personal paths) ---
config.json

# --- Local machine-specific launchers (superseded by the packaged app) ---
BO2 Toolkit.bat
BO2 Status Label.bat
Play BO2.bat

# --- Crash dumps / logs from the game folder, if any get copied in ---
*.dmp
*.log

# --- OS junk ---
Thumbs.db
Desktop.ini
.DS_Store
